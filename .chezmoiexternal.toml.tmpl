# ---------------------------------------------------------------------------
# 古いディストリの apt に収録が無いもの
#
# Ubuntu 22.04 の apt には delta / dust / eza / sd / starship / tokei が無い。
# 新しいディストリでは apt / pacman 側が入れるので、そちらが PATH の先に来る。
# ここに並べておいて困るのは、収録のある環境で使われないバイナリが 1 つ増える
# ことだけで、上の btm や procs と同じ割り切りである。
#
# 配布形式は gnu を既定にし、musl を使うのは 2 つの場合だけである
# (docs/design.md#古いディストリでも動く形で配る を参照)。glibc 版はビルドに使った環境の glibc より古い
# システムでは動かず、実際 yazi v26.9.1 の gnu 版は GLIBC_2.39 を要求するため
# Ubuntu 22.04 (glibc 2.35) では起動しない。musl 版は静的リンクなので
# ディストリの新旧に左右されない。
# delta / eza / tokei は aarch64 の musl 版を配っていないので gnu 版を使うが、
# 固定しているアセットの要求を実測すると eza と tokei が GLIBC_2.18、uv が 2.17、
# bottom / delta / dust / ouch が 2.34 で、いずれも 22.04 の 2.35 に収まる。
# ---------------------------------------------------------------------------

[".local/share/dotfiles/bin/delta"]
    type = "archive-file"
    url = "https://github.com/dandavison/delta/releases/download/{{ $deltaVersion }}/delta-{{ $deltaVersion }}-{{ $rustArch }}-unknown-linux-gnu.tar.gz"
    path = "delta-{{ $deltaVersion }}-{{ $rustArch }}-unknown-linux-gnu/delta"
    executable = true
    refreshPeriod = "720h"
    [".local/share/dotfiles/bin/delta".checksum]
        sha256 = "{{ $deltaSha }}"

# dust で musl 版を避けている理由。並列に走査してノードを大量に確保するため、
# musl の mallocng の遅さがそのまま出る。80,000 ファイルの走査で musl 版は
# 116.5ms、gnu 版は 22.4ms だった。gnu 版の要求は GLIBC_2.34 で 22.04 (2.35)
# に収まるので、ここは速いほうを取る。
[".local/share/dotfiles/bin/dust"]
    type = "archive-file"
    url = "https://github.com/bootandy/dust/releases/download/{{ $dustVersion }}/dust-{{ $dustVersion }}-{{ $rustArch }}-unknown-linux-gnu.tar.gz"
    path = "dust-{{ $dustVersion }}-{{ $rustArch }}-unknown-linux-gnu/dust"
    executable = true
    refreshPeriod = "720h"
    [".local/share/dotfiles/bin/dust".checksum]
        sha256 = "{{ $dustSha }}"

[".local/share/dotfiles/bin/eza"]
    type = "archive-file"
    url = "https://github.com/eza-community/eza/releases/download/{{ $ezaVersion }}/eza_{{ $rustArch }}-unknown-linux-gnu.tar.gz"
    # eza の書庫だけ、メンバー名が "./eza" と頭に ./ が付く形で記録されている。
    path = "./eza"
    executable = true
    refreshPeriod = "720h"
    [".local/share/dotfiles/bin/eza".checksum]
        sha256 = "{{ $ezaSha }}"

[".local/share/dotfiles/bin/sd"]
    type = "archive-file"
    url = "https://github.com/chmln/sd/releases/download/{{ $sdVersion }}/sd-{{ $sdVersion }}-{{ $rustArch }}-unknown-linux-musl.tar.gz"
    path = "sd-{{ $sdVersion }}-{{ $rustArch }}-unknown-linux-musl/sd"
    executable = true
    refreshPeriod = "720h"
    [".local/share/dotfiles/bin/sd".checksum]
        sha256 = "{{ $sdSha }}"

[".local/share/dotfiles/bin/starship"]
    type = "archive-file"
    url = "https://github.com/starship/starship/releases/download/{{ $starshipVersion }}/starship-{{ $rustArch }}-unknown-linux-musl.tar.gz"
    path = "starship"
    executable = true
    refreshPeriod = "720h"
    [".local/share/dotfiles/bin/starship".checksum]
        sha256 = "{{ $starshipSha }}"

# tokei は v13 以降、リリースにバイナリが添付されていない。実体があるのは
# v12.1.2 が最後なので、ここだけ上流の最新ではなくそれを固定している。
# 収録のあるディストリでは、そちらの新しいほうが PATH の先に来る。
[".local/share/dotfiles/bin/tokei"]
    type = "archive-file"
    url = "https://github.com/XAMPPRocky/tokei/releases/download/{{ $tokeiVersion }}/tokei-{{ $rustArch }}-unknown-linux-gnu.tar.gz"
    path = "tokei"
    executable = true
    refreshPeriod = "720h"
    [".local/share/dotfiles/bin/tokei".checksum]
        sha256 = "{{ $tokeiSha }}"

{{ if .nodejs }}
# fnm は Node.js のバージョン管理。Node.js を入れる選択をしたときだけ取得する。
# apt には収録が無く、pacman の extra にはあるので、実際にここから降りてくるのは
# Debian 系だけになる (Arch では /usr/bin のほうが PATH の先に来る)。
#
# 配布されているのは静的リンクの単一バイナリなので、Ubuntu 22.04 でも glibc の
# 版を気にせず動く。zip の中身は fnm 1 つだけ。
[".local/share/dotfiles/bin/fnm"]
    type = "archive-file"
    url = "https://github.com/Schniz/fnm/releases/download/{{ $fnmVersion }}/{{ $fnmAsset }}.zip"
    path = "fnm"
    executable = true
    refreshPeriod = "720h"
    [".local/share/dotfiles/bin/fnm".checksum]
        sha256 = "{{ $fnmSha }}"
{{ end }}
