# ---------------------------------------------------------------------------
# zsh プラグイン
#
# OS のパッケージマネージャに頼らず git clone で統一する。これにより
# .zshrc の source 先が 3 OS で完全に同一になる。
# zsh-abbr は zsh-job-queue をサブモジュールとして内包する (下記参照)。
# ---------------------------------------------------------------------------

[".local/share/zsh/plugins/zsh-syntax-highlighting"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting.git"
    refreshPeriod = "168h"
    [".local/share/zsh/plugins/zsh-syntax-highlighting".clone]
        args = ["--depth", "1"]
    [".local/share/zsh/plugins/zsh-syntax-highlighting".pull]
        args = ["--ff-only"]

[".local/share/zsh/plugins/zsh-autosuggestions"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-autosuggestions.git"
    refreshPeriod = "168h"
    [".local/share/zsh/plugins/zsh-autosuggestions".clone]
        args = ["--depth", "1"]
    [".local/share/zsh/plugins/zsh-autosuggestions".pull]
        args = ["--ff-only"]

# zsh-abbr v6 は zsh-job-queue を「サブモジュールとして自身の配下に」持つことを
# 前提に書かれている (zsh-abbr.zsh が ${ABBR_SOURCE_PATH}/zsh-job-queue/ を
# 直接 source し、無ければ起動時にエラーを出す)。兄弟として並べても動かないため、
# 必ず --recurse-submodules で取得する。
[".local/share/zsh/plugins/zsh-abbr"]
    type = "git-repo"
    url = "https://github.com/olets/zsh-abbr.git"
    refreshPeriod = "168h"
    [".local/share/zsh/plugins/zsh-abbr".clone]
        args = ["--depth", "1", "--branch", "v6", "--recurse-submodules", "--shallow-submodules"]
    [".local/share/zsh/plugins/zsh-abbr".pull]
        args = ["--ff-only", "--recurse-submodules"]

# ---------------------------------------------------------------------------
# tmux plugin manager
#
# TPM 配下のプラグイン本体は TPM 自身に任せる
# (run_onchange_after_30-tmux-plugins.sh が install_plugins を呼ぶ)。
# ---------------------------------------------------------------------------

[".config/tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"
    [".config/tmux/plugins/tpm".clone]
        args = ["--depth", "1"]
    [".config/tmux/plugins/tpm".pull]
        args = ["--ff-only"]

