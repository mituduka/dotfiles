# ---------------------------------------------------------------------------
# パッケージマネージャに無いツールを補う置き場 (Linux のみ)
#
# 置き場は ~/.local/share/dotfiles/bin で、PATH の「最後」に入れてある
# ($ZDOTDIR/.zshenv を参照)。したがって
#
#   - apt / pacman が同じツールを入れていれば /usr/bin 側が使われる
#   - 入れていなければここのバイナリが使われる
#
# という優先順位になり、「パッケージマネージャを優先し、無いものだけ
# GitHub Releases で補う」という方針がそのまま PATH で表現される。
#
# ここを ~/.local/bin に置くと逆転する。~/.local/bin は PATH の先頭にあるため、
# pacman で入れた新しい procs を、ここでバージョン固定した古い procs が
# 常に先に見つかってしまう。分けているのはそのためで、統合してはいけない。
#
# ディストリごとの収録差を気にせず全部宣言してよいのも、この優先順位のおかげ。
# ---------------------------------------------------------------------------

[".local/share/dotfiles/bin/btm"]
    type = "archive-file"
    url = "https://github.com/ClementTsang/bottom/releases/download/{{ $bottomVersion }}/bottom_{{ $rustArch }}-unknown-linux-gnu.tar.gz"
