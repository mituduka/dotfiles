# ~/.config/git/config
#
# 従来の ~/.gitconfig ではなく XDG の場所に置く。git は
# $XDG_CONFIG_HOME/git/config を ~/.gitconfig と同等に扱う。
#
# user.name / user.email は chezmoi init 時のプロンプトで入力した値が
# ここに埋め込まれる。マシンごとに別の値を使えるうえ、
# ソースリポジトリには平文で入らない。

[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}

[init]
	defaultBranch = main

[ghq]
	root = ~/src

[core]
	# excludesfile は書かない。git は $XDG_CONFIG_HOME/git/ignore を既定で読むので
	# 指定は不要なうえ、ホームの絶対パスを埋め込むと XDG_CONFIG_HOME を
	# 動かした環境で実在しない場所を指すことになる。
	#
	# pager は delta があるときだけ設定する。無条件に書くと、delta を入れられ
	# なかった環境で git diff / git show / git log -p がすべて
	# 「delta が無い」で失敗する。lookPath はパッケージ導入スクリプト
	# (run_once_before_) の後に評価されるので、初回の apply から正しく効く。
	# 後から delta を入れて chezmoi apply すれば、以下の節は自動で復活する。
{{- if lookPath "delta" }}
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
{{- end }}

# conflictstyle は git のバージョンを見て決める。zdiff3 が使えるのは git 2.35
# 以降で、それより古い git は知らない値を渡されるとマージ系のコマンドがその場で
# 終了する。警告して既定値に戻る、という動きではない。Ubuntu 22.04 の git は
# 2.34 なので、ここに zdiff3 と直接書くと merge も rebase も cherry-pick も
# できなくなる。2.35 に届かない環境では diff3 に落とす。どちらも衝突箇所に
# 共通の祖先を出す点は同じで、zdiff3 は両側で一致する行をそこから取り除く。
{{ $gitVersion := "" -}}
{{- if lookPath "git" -}}
{{-   $gitVersion = output "git" "--version" | regexFind `[0-9]+\.[0-9]+\.[0-9]+` -}}
{{- end -}}
{{- $conflictStyle := "diff3" -}}
{{- if $gitVersion -}}
{{-   if semverCompare ">=2.35.0" $gitVersion -}}
{{-     $conflictStyle = "zdiff3" -}}
{{-   end -}}
{{- end -}}
[merge]
	conflictstyle = {{ $conflictStyle }}

[diff]
	colorMoved = default
	algorithm = histogram

[push]
	# autoSetupRemote が効くのは git 2.37 以降。古い git は知らないキーとして
	# 黙って無視するので、そこでは git push -u origin HEAD を自分で打つ。
	autoSetupRemote = true

[pull]
	ff = only

[fetch]
	prune = true

[rerere]
	enabled = true

[alias]
	st = status --short --branch
	co = checkout
	sw = switch
	br = branch
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	last = log -1 HEAD --stat
	unstage = restore --staged
