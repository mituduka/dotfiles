{{- /* zshFunctions だけ既定が true である。外から何も取ってこず、この
       リポジトリが持つファイルを置くだけなので (.chezmoi.toml.tmpl を参照)、
       キーが無いマシンでも入れる。ここを false にすると、まだ chezmoi init を
       やり直していない既存のマシンで y が黙って消える。 */ -}}

# $ZDOTDIR/.zshrc
#
# 対話シェルでのみ読まれる。読み込み順序には意味があるので、
# 節の順番を入れ替えるときは各節の注記を確認すること。

# ===============================================
# Ghostty shell integration
#
# 端末側の機能 (プロンプト位置の把握、カレントディレクトリの引き継ぎなど) を
# 有効にする。他の初期化より先に行う必要がある。
# ===============================================
# 変数だけを見てはいけない。tmux のセッションに別の端末から attach したとき、
# sudo -E、docker exec、ssh の SendEnv など、変数だけが残ってファイルが無い
# 状況がある。そのたびに no such file or directory が出る。
if [[ -r "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration" ]]; then
  source "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration"
fi

{{ if eq .chezmoi.os "darwin" -}}
# ===============================================
# Homebrew
# ===============================================
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  # brew shellenv は /opt/homebrew/bin を PATH の先頭に差し込む。そのままだと
  # ~/.local/bin や fnm の既定版、$CARGO_HOME/bin より前に出てしまうので、.zshenv が決めた順序に
  # 戻す (関数の定義は $ZDOTDIR/.zshenv を参照)。
  (( $+functions[_dotfiles_set_path] )) && _dotfiles_set_path
fi

{{ end -}}
# ===============================================
# history / shell options
#
# ここに置くのには理由がある。macOS の /etc/zshrc は .zshenv より後、
# この .zshrc より前に読まれ、次の 4 つを無条件に上書きしてくる。
#
#     HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
#     HISTSIZE=2000
#     SAVEHIST=1000
#     setopt BEEP
#
# したがって .zshenv でどう設定しても効かない。/etc/zshrc の後に読まれる
# この位置で設定し直す必要がある。
#
# なお HISTFILE / HISTSIZE / SAVEHIST / LISTMAX はいずれも zsh が自分で読む
# シェル変数であり、export してはいけない。とくに HISTFILE を export すると
# bash も同じ値を見るため、zsh から起動した bash が zsh の履歴ファイルへ
# 追記し、extended_history の形式に生の行が混ざる。
# ===============================================
HISTFILE=${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"

# メモリに保持する履歴の件数。
# zsh は「メモリにある分」しか履歴ファイルに書かないため、HISTSIZE が
# SAVEHIST より小さいと SAVEHIST を大きくしても意味がない。
# (旧設定は HISTSIZE=1000 / SAVEHIST=100000 で、実際には 1000 件しか
#  残らない状態だった。) 両方を揃える。
HISTSIZE=100000
# 履歴ファイルに保存する履歴の件数
SAVEHIST=100000

# 開始と終了を記録
setopt extended_history
# ヒストリに追加されるコマンド行が古いものと同じなら古いものを削除
# (hist_ignore_dups を包含するので、そちらは設定しない)
setopt hist_ignore_all_dups
# スペースで始まるコマンド行はヒストリリストから削除
setopt hist_ignore_space
# ヒストリを呼び出してから実行する間に一旦編集可能
setopt hist_verify
# 余分な空白は詰めて記録
setopt hist_reduce_blanks
# 古いコマンドと同じものは無視
setopt hist_save_no_dups
# history コマンドは履歴に登録しない
setopt hist_no_store
# history 共有
setopt share_history

# zsh の補完候補が画面から溢れ出る時、それでも表示するか確認
LISTMAX=50
# 補完候補を詰めて表示
setopt list_packed
# ファイル種別記号を補完候補の末尾に表示しない
unsetopt list_types
# ビープを鳴らさない (/etc/zshrc の setopt BEEP を打ち消す)
unsetopt beep
# バックグラウンドジョブの優先度(ionice)を bash と同じ挙動に
unsetopt bg_nice

{{ if eq .chezmoi.os "darwin" -}}
# ===============================================
# fpath (Homebrew の補完定義)
#
# brew shellenv が追加する share/zsh/site-functions とは別ディレクトリで、
# zsh-completions formula の 180 個ほどの定義がこちらに入っている。
#
# compinit は「その時点の fpath」を走査して補完定義を集め、結果を zcompdump に
# 書き出す。したがって fpath への追加は compinit より前でなければならず、
# 後ろに書くと 1 つも登録されない。下の「自作の zsh 関数」も同じ理由で
# compinit より前に置いてある。
# ===============================================
# HOMEBREW_PREFIX は 2 つ上の brew shellenv が export している。ここで
# brew --prefix を呼ぶと同じ値を得るために毎回サブプロセスが 1 つ増える
# (このマシンの実測で約 7ms、対話シェルの起動時間の 1 割強にあたる)。
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  FPATH="${HOMEBREW_PREFIX}/share/zsh-completions:$FPATH"
fi

{{ end -}}
{{ if .zshFunctions -}}
# ===============================================
# fpath (自作の zsh 関数)
#
# $ZDOTDIR/functions/<名前> に 1 ファイル 1 関数で置き、autoload で必要に
# なったときだけ読み込む。.zshrc に直接書くのと違い、起動時に読むのは
# ファイル名の一覧だけで済む。
#
# 各ファイルの中身は関数の「本体」であって、y() { ... } では包まない。
# autoload -Uz はファイルの内容をそのまま本体として扱う。
#
# fpath への追加なので、この節は compinit より前でなければならない。
#
# グロブ修飾子の意味は次のとおり。
#   N   マッチが無いときにエラーにせず空にする
#   -.  通常ファイルだけを採る。- を付けるとシンボリックリンクは辿った先で
#       判定するので、リンクで置いた関数も拾える (- が無いと黙って落ちる)
#   :t  パスからファイル名だけを取り出す
#
# そのあと :#_* で _ 始まりを落とす。そちらは補完定義の置き場であって関数では
# なく、autoload すると compdef の指示ごと関数として読み込むことになる。
# (この節は fpath にも足すので、補完定義を置きたければ置ける。ただし
#  compinit -C は fpath を読み直さないため、zcompdump を消すまで効かない。)
#
# 引数が空のまま autoload を呼ぶと、何もせずに済ませるどころか autoload 可能な
# 関数の一覧を吐くので、件数を数えてから呼んでいる。
# ===============================================
() {
  local dir="${ZDOTDIR:-$HOME/.config/zsh}/functions"
  [[ -d "$dir" ]] || return 0
  fpath=("$dir" $fpath)
  local -a fns=("$dir"/*(N-.:t))
  fns=(${fns:#_*})
  (( $#fns )) && autoload -Uz $fns
}

{{ end -}}
# ===============================================
# completion
#
# プラグインより先に compinit を済ませる。zsh-abbr が compinit 済みを
# 前提にしているため、この順序は入れ替えられない。
#
# -C は zcompdump の鮮度チェックを省いて起動を速くする代わり、新しく入れた
# コマンドの補完がキャッシュを消すまで出てこない。出ないときは
#   rm "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump" && exec zsh
# ===============================================
ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
[[ -d "${ZSH_COMPDUMP:h}" ]] || mkdir -p "${ZSH_COMPDUMP:h}"

autoload -Uz compinit
compinit -C -d "$ZSH_COMPDUMP"

# menu select
zstyle ':completion:*' menu select

# ===============================================
# plugins
#
# 3 OS で同じ場所から読めるよう、パッケージマネージャではなく
# chezmoi の externals が git clone したものを使う
# (.chezmoiexternal.toml.tmpl を参照)。
#
# 順序:
#   1. zsh-abbr              compinit の後でなければならない
#   2. zsh-autosuggestions
#   3. zsh-syntax-highlighting  必ず最後。これより後に読むと
#                               他プラグインの入力フックを拾えなくなる
# ===============================================
# zsh-abbr v6 が内包する zsh-job-queue は、キューの置き場を
# ${TMPDIR:-/tmp}/zsh-job-queue に決め打ちする。TMPDIR がユーザ固有でない
# Linux では全ユーザ共有になり、最初に zsh を起動した人が 0755 で作った
# ディレクトリに 2 人目が書けず、起動のたびに permission denied を吐いて
# 略語が 1 つも展開されなくなる (sudo -i のあと自分に戻るだけで踏む)。
# 置き場を明示してユーザ固有にする。zsh-abbr を読む前でなければ効かない。
export JOB_QUEUE_TMPDIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-job-queue"

ZSH_PLUGIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

() {
  local plugin
  for plugin in \
    "$ZSH_PLUGIN_DIR/zsh-abbr/zsh-abbr.zsh" \
    "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  do
    [[ -r "$plugin" ]] && source "$plugin"
  done
}

# ===============================================
# alias
#
# 略語 (abbr) は $XDG_CONFIG_HOME/zsh-abbr/user-abbreviations で管理する。
# .zshrc で abbr を定義すると起動のたびに同ファイルへ書き込みが走るため、
# ここには置かない。
#
# この設定は 3 つの OS で共有されるため、ツールが入っていないマシンでも
# 壊れないよう存在チェックで包む。eza が無ければ本物の ls がそのまま残る
# (略語のうち `lt` だけは eza 専用の --tree を使うので動かなくなる)。
# ===============================================
if command -v eza >/dev/null 2>&1; then
  alias ls='eza -F --icons --git --group-directories-first'
fi

# ===============================================
# zoxide (ディレクトリジャンプ)
#
# `z <部分一致>` で頻度と最終使用時刻から目的のディレクトリへ飛ぶ。
# `zi` は候補を fzf で選ばせる。
# ===============================================
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# ===============================================
# fzf
#
# Ctrl-R  履歴検索
# Ctrl-T  カレント以下のファイルを挿入
# Alt-C   カレント以下のディレクトリへ cd
# ===============================================
if command -v fzf >/dev/null 2>&1; then
  # fzf 0.48 以降は `fzf --zsh` がキーバインドと補完をまとめて出力する。
  # それ以前の版 (Debian 系の古いパッケージなど) は個別ファイルを読む。
  #
  # ここで `source <(fzf --zsh)` の成否を見てはいけない。source の終了
  # コードは「読み込んだ内容の最後のコマンドの結果」であり、fzf --zsh が
  # 失敗して出力が空でも 0 を返すため、古い fzf でもフォールバックに
  # 落ちずキーバインドが一切設定されないまま通過してしまう。
  # 出力をいったん受けて、中身の有無で判定する。
  #
  # 読み込む側の 2>/dev/null は、どちらの経路でも外さないこと。fzf の初期化は
  # 現在の setopt を一通り走査して保存・復元するが、その中には端末が無いと変更
  # できない zle が含まれる。TTY の無い対話シェル (docker exec や CI など) では
  # "can't change option: zle" が出る。fzf 自身も同種の setopt を
  # 2>/dev/null 付きで書いており、抑止するのが上流の流儀。
  _fzf_init="$(fzf --zsh 2>/dev/null)"
  if [[ -n "$_fzf_init" ]]; then
    eval "$_fzf_init" 2>/dev/null
  else
    () {
      # 打ち切りの判定に source の終了コードを使わないこと。数行上に書いた
      # とおり source が返すのは「読み込んだ内容の最後のコマンドの結果」で、
      # 読み込めたかどうかではない。fzf の初期化は末尾が bindkey / zle -N な
      # ので、TTY の無い対話シェルでは非ゼロを返しうる。&& で繋ぐと打ち切れず
      # 2 つ目まで読んで同じウィジェットを二重に定義する。読めたかどうかだけで
      # 判断する。
      local f
      for f in \
        /usr/share/doc/fzf/examples/key-bindings.zsh \
        /usr/share/fzf/key-bindings.zsh
      do
        if [[ -r "$f" ]]; then
          source "$f" 2>/dev/null
          break
        fi
      done
      for f in \
        /usr/share/doc/fzf/examples/completion.zsh \
        /usr/share/fzf/completion.zsh
      do
        if [[ -r "$f" ]]; then
          source "$f" 2>/dev/null
          break
        fi
      done
    }
  fi
  unset _fzf_init

  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  fi
fi

{{ if .nodejs -}}
# ===============================================
# fnm (Node.js のバージョン管理)
#
# $ZDOTDIR/.zshenv がやっているのは、デフォルト版への固定パス
# ($FNM_DIR/aliases/default/bin) を PATH に入れることだけである。それだけでも
# node と npm は使えるが、版を切り替えることはできない。ここで fnm env を
# 通すと、このシェル専用の PATH (FNM_MULTISHELL_PATH) が先頭に割り当てられ、
# fnm use が他のシェルに影響せずに効くようになる。
#
# --use-on-cd は .node-version / .nvmrc / package.json のあるディレクトリに
# 入ったときに fnm use を自動で呼ぶ。そこで指定された版が入っていないと
# 移動のたびに知らせが出るので、うるさければこのフラグを外す。
#
# この節は対話シェルにしか要らない。非対話シェルにまで fnm env を通すと、
# シェルを起動するたびにプロセスが 1 つ増えるうえ、使い捨ての multishell
# ディレクトリが増え続ける。置き場は XDG_RUNTIME_DIR があればそこ (Linux では
# /run/user/<uid> で、再起動すれば消える)、無ければ $XDG_STATE_HOME になる
# (macOS はこちら。消えないので、対話シェルのぶんだけに留めておきたい)。
#
# macOS では brew shellenv より後になければならない。brew shellenv は
# /opt/homebrew/bin を PATH の先頭に置き直すので、先に書くと brew で node を
# 入れているマシンでそちらが先に見つかる。
# ===============================================
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell zsh --use-on-cd)"
fi

{{ end -}}
# ===============================================
# direnv (ディレクトリ単位の環境変数)
#
# .envrc を置いたディレクトリに入ると、そこに書いた環境変数が読み込まれ、
# 出ると元に戻る。新しい .envrc は `direnv allow` で許可するまで読まれない。
# 中身は任意のシェルコードなので、他人のリポジトリでは中を読んでから許可する。
#
# フックは precmd_functions と chpwd_functions の「先頭」に自分を差し込む。
# したがってこの行を .zshrc のどこに置いても、プロンプトの描画より先に走る。
# ===============================================
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# ===============================================
# keybindings
#
# Option + 左右矢印は Ghostty の既定では esc:b / esc:f (単語移動) だが、
# それだと tmux の M-Left / M-Right によるペイン移動が効かないため、
# ghostty 側で本来の CSI シーケンスを送るよう戻してある。
# その結果ここで拾えるようになるので、単語移動を割り当て直す。
#
# tmux の中では tmux が先に受け取るため、ペイン移動が優先される。
#
# 先に bindkey -e で emacs キーマップを明示する。これを省くと、zsh は
# VISUAL / EDITOR の値を見てキーマップを決める。$ZDOTDIR/.zshenv は nano が
# 無い環境で EDITOR を vi まで落とすので、最小構成のコンテナや、パッケージ
# 導入より前に開いたシェルでは vi キーマップになり、Ctrl-A / Ctrl-E /
# Alt-B / Alt-F が一斉に効かなくなる。下の 2 行も viins 側に登録されて
# Esc 前置と食い合う。エディタの選択とキーマップは切り離しておく。
# ===============================================
bindkey -e
bindkey '\e[1;3D' backward-word
bindkey '\e[1;3C' forward-word

# ===============================================
# Starship (プロンプト)
#
# テーマは Gruvbox Rainbow preset。Nerd Font が必要なので、
# 記号が □ になる場合はターミナルのフォント設定を確認すること。
# ===============================================
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
