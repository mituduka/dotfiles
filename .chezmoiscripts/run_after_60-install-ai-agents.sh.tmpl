{{- if or .claudeCode .codexCli .copilotCli -}}
#!/bin/sh
#
# AI コーディングエージェントの導入 (任意)。
#
# 3 つとも提供元の公式インストールスクリプトを使う。パッケージマネージャ
# (brew cask / apt / winget) にも同じものはあるが、こちらを選んだ理由は
# docs/design.md#ai-エージェントの入れ方 に書いた。要点は 3 つ。
#
#   - 3 OS で手順が同一になる。brew cask は macOS だけ、apt / pacman には
#     Codex と Copilot の収録が無い
#   - sudo が要らない。3 つとも ~/.local/bin に入る
#   - 自分で自分を更新する。パッケージマネージャ経由だと apply の
#     タイミングでしか上がらない
#
# run_once_ ではなく run_ にしてある (毎回走る)。理由は
# run_after_20-setup-shell.sh と同じである。
#
# chezmoi が「実行済み」として記録するのは終了コード 0 で終えたスクリプトだけ
# なので、素直に失敗すれば run_once_ でも再試行される。ところがこのスクリプトは
# 導入に失敗しても警告だけ出して 0 で終える (apply 全体を道連れにしないため)。
# その結果 run_once_ だと「失敗したが 0 で終えた回」が実行済みとして記録され、
# 以後どれだけ apply しても再試行されない。到達したい状態を毎回確かめる形にする。
#
# 代償として、run_ のスクリプトは中身が変わっていなくても chezmoi status と
# chezmoi diff に毎回現れる (docs/chezmoi.md の「スクリプト」を参照)。
#
# 到達済みのときは command -v を 3 回呼ぶだけで終わる。

set -eu

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# ~/.local/bin を PATH に入れてから呼ぶ。これを省いてはいけない。
#
# Codex と Copilot のインストーラは「インストール先が PATH に無ければ
# シェルの設定ファイルに export PATH の行を書き足す」という作りになっている。
# 書き足す先は Copilot が $ZDOTDIR/.zprofile、Codex が macOS では
# ~/.zprofile、Linux では ~/.zshrc である。~/.zshrc はこのリポジトリでは
# ~/.config/zsh/.zshrc へのシンボリックリンクなので、chezmoi が管理している
# ファイルを直接書き換えられることになる。
#
# Copilot はこれだけで何もしなくなる。Codex はもう少し込み入っていて、
# add_to_path() の早期 return には「PATH にあり、かつ他のパッケージマネージャ
# 管理の codex を検出していない」という条件が付く。brew や npm で入れた codex
# が別にあると、PATH に通っていても書き込みにいく。そちらは下の command -v で
# 「既に入っているなら呼ばない」ことが二段目の守りになっている。
#
# Copilot はそのうえ [y/N] を聞いてくるため、通しておかないと apply が
# 入力待ちで止まる。
# ---------------------------------------------------------------------------
mkdir -p "$HOME/.local/bin"
PATH="$HOME/.local/bin:$PATH"
export PATH

{{ if or .claudeCode .copilotCli -}}
# Claude Code と Copilot のインストーラは bash で書かれている (Codex は sh)。
# macOS の /bin/bash (3.2) でも動くので、あるかどうかだけ見る。
# 無いときも exit はしない。bash を要るものだけを飛ばし、Codex は入れる。
HAVE_BASH=1
if ! command -v bash >/dev/null 2>&1; then
    # あとから「入っていない」と気づいたときに理由へたどり着けるよう名指しする。
    warn 'bash が見つかりません。次のものを飛ばします:{{ if .claudeCode }} claude{{ end }}{{ if .copilotCli }} copilot{{ end }}'
    HAVE_BASH=0
fi

{{ end -}}
# ---------------------------------------------------------------------------
# 導入して、入ったことを確かめる
#
# install_agent <コマンド名> <実行するインストーラ>
#
# 終わったあとに実体を見にいくのを省いてはいけない。`curl ... | bash` の
# 終了コードはパイプラインの最後、つまり bash のものであって curl のもので
# はない。名前が引けない、404 が返る、プロキシに拒まれる、といった場合でも
# curl は何も出力せずに終わり、bash は空の入力を読んで 0 を返す。
# POSIX sh に pipefail は無いので set -e も拾えない。確かめずに進むと、
# 何も入っていないのに「導入しました。認証してください」と表示することになる。
#
# 置き場はどれも ~/.local/bin である。command -v ではなく実体を見ているのは、
# 「どこかに入った」ではなく「想定した置き場に入った」ところまで確かめたい
# からである。インストーラが別の場所を選んだ場合も失敗として扱える。
#
# 失敗しても中断しない。毎回走るスクリプトなので、次の apply で再試行される。
# ---------------------------------------------------------------------------
NEED_AUTH=''

install_agent() {
    _name="$1"
    shift
    log "$_name を導入します"
    if "$@" && [ -x "$HOME/.local/bin/$_name" ]; then
        NEED_AUTH="$NEED_AUTH $_name"
    else
        warn "$_name の導入に失敗しました。次の chezmoi apply で再試行します。"
    fi
}

{{ if .claudeCode }}
# ---------------------------------------------------------------------------
# Claude Code
#
# ~/.local/bin/claude は ~/.local/share/claude/versions/ 配下への
# シンボリックリンクになる。以後の更新はバックグラウンドで本体が行うので、
# ここが再び走ることはない。
# ---------------------------------------------------------------------------
claude_install() { curl -fsSL https://claude.ai/install.sh | bash; }
if ! command -v claude >/dev/null 2>&1 && [ "$HAVE_BASH" -eq 1 ]; then
    install_agent claude claude_install
fi
{{ end }}
{{ if .codexCli }}
# ---------------------------------------------------------------------------
# Codex CLI
#
# CODEX_NON_INTERACTIVE は「今すぐ Codex を起動しますか」などの [y/N] を
# 抑止する。apply の途中で入力待ちにならないよう、必ず付ける。
# ---------------------------------------------------------------------------
codex_install() { curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh; }
if ! command -v codex >/dev/null 2>&1; then
    install_agent codex codex_install
fi
{{ end }}
{{ if .copilotCli }}
# ---------------------------------------------------------------------------
# GitHub Copilot CLI
#
# PREFIX を明示するのは、インストーラが root で動いているときに
# /usr/local へ入れようとするためである。コンテナなど root で apply する
# 環境でも、置き場を ~/.local に揃えておく。
# ---------------------------------------------------------------------------
copilot_install() { curl -fsSL https://gh.io/copilot-install | PREFIX="$HOME/.local" bash; }
if ! command -v copilot >/dev/null 2>&1 && [ "$HAVE_BASH" -eq 1 ]; then
    install_agent copilot copilot_install
fi
{{ end }}
# ---------------------------------------------------------------------------
# 認証は対話でしかできないので、ここではやらない。何が残っているかだけ伝える。
# ---------------------------------------------------------------------------
if [ -n "$NEED_AUTH" ]; then
    log '導入しました。認証は自分で済ませてください。'
    for tool in $NEED_AUTH; do
        case "$tool" in
            claude)  log '  claude            起動するとブラウザが開きます' ;;
            codex)   log '  codex login       ChatGPT のアカウントか API キー' ;;
            copilot) log '  copilot           起動して /login と打ちます' ;;
        esac
    done
    log 'いずれも新しいシェルを開いてから実行してください。'
fi
{{ end -}}
