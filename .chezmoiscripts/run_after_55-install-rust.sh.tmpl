{{- if .rust -}}
#!/bin/sh
#
# Rust の導入 (任意)。ツールチェインの管理には rustup を使う。
#
# rustup は公式インストールスクリプト (sh.rustup.rs) で入れる。brew / apt /
# pacman にも rustup や rust はあるが、こちらを選んだ理由は AI エージェントと
# 同じである (docs/design.md#rust-を-rustup-で入れる)。
#
#   - 3 OS で手順が同一になる。apt の rustup は Ubuntu 24.04 以降にしか無い
#   - sudo が要らない。置き場は ~/.local/share の下に閉じる
#   - rustup 自身とツールチェインの更新を rustup update 1 つで済ませられる
#
# リンカ (cc) はパッケージ導入スクリプトが入れる (Linux では build-essential /
# base-devel)。macOS では Homebrew の導入時に Command Line Tools が入っている。
#
# run_once_ ではなく run_ にしてある (毎回走る)。理由は
# run_after_20-setup-shell.sh と同じである。
#
# chezmoi が「実行済み」として記録するのは終了コード 0 で終えたスクリプトだけ
# なので、素直に失敗すれば run_once_ でも再試行される。ところがこのスクリプトは
# 導入に失敗しても警告だけ出して 0 で終える (apply 全体を道連れにしないため)。
# その結果 run_once_ だと「失敗したが 0 で終えた回」が実行済みとして記録され、
# 以後どれだけ apply しても再試行されない。到達したい状態を毎回確かめる形にする。
#
# 代償として、run_ のスクリプトは中身が変わっていなくても chezmoi status と
# chezmoi diff に毎回現れる (docs/chezmoi.md の「スクリプト」を参照)。
#
# 到達済みのときは rustup を 2 回呼ぶだけで終わる。ネットワークは触らない。

set -eu

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# 置き場を固定する
#
# RUSTUP_HOME と CARGO_HOME は $ZDOTDIR/.zshenv と同じ値でなければならない。
# 片方だけ変えると、.zshenv が PATH に入れた場所と実体の置き場がずれて
# cargo が見つからなくなる。
#
# rustup の既定は ~/.rustup と ~/.cargo で、ホーム直下を 2 つ汚す。XDG に
# 寄せたうえで、継承した XDG_DATA_HOME には従わない。理由は
# run_after_50-install-node.sh.tmpl の FNM_DIR と同じである。
# ---------------------------------------------------------------------------
DOTFILES_DATA_HOME="$HOME/.local/share"
RUSTUP_HOME="$DOTFILES_DATA_HOME/rustup"
CARGO_HOME="$DOTFILES_DATA_HOME/cargo"
export RUSTUP_HOME CARGO_HOME

# 到達判定と導入後の確認で、ツールチェインを勝手に取りにいかせない。rustup は
# 既定やオーバーライドで指定された版が入っていないと、cargo を呼んだ時点で
# ダウンロードを始める (1.28.0 で一度止めたが 1.28.1 で既定に戻り、この変数で
# 切れるようになった)。到達済みの判定でネットワークに触らないよう止めておく。
RUSTUP_AUTO_INSTALL=0
export RUSTUP_AUTO_INSTALL

RUSTUP="$CARGO_HOME/bin/rustup"

# ---------------------------------------------------------------------------
# 到達済みかどうかを確かめる
#
# default_toolchain は既定のツールチェインの名前を出す。未設定なら空になる。
# `rustup default` は「stable-aarch64-apple-darwin (default)」のように出し、
# 未設定なら終了コード 1 を返す。
#
# 判定に素の cargo --version を使ってはいけない。cargo は rustup のプロキシで、
# 作業ディレクトリ (とその親) の rust-toolchain.toml や RUSTUP_TOOLCHAIN に
# 従う。そこに入っていない版が書いてあると判定が毎回失敗し、そのたびに導入を
# やり直すことになる。`rustup default` と `rustup run <版>` はどちらも
# オーバーライドを見ないので、既定のツールチェインそのものを確かめられる。
#
# 既定の版を stable に決め打ちしないのは、自分で nightly などに切り替えた
# マシンでその選択を上書きしないためである。
# ---------------------------------------------------------------------------
default_toolchain() {
    _out="$("$RUSTUP" default 2>/dev/null)" || return 0
    printf '%s' "${_out%% *}"
}

toolchain_works() {
    [ -n "$1" ] && "$RUSTUP" run "$1" cargo --version >/dev/null 2>&1
}

if [ -x "$RUSTUP" ] && toolchain_works "$(default_toolchain)"; then
    exit 0
fi

# ---------------------------------------------------------------------------
# 導入する
#
# --no-modify-path を省いてはいけない。rustup-init は既定で ~/.profile や
# ~/.zshenv などに `. "$CARGO_HOME/env"` を書き足す。~/.zshenv は chezmoi が
# 管理しているファイルなので、直接書き換えられることになる。PATH は
# $ZDOTDIR/.zshenv が通している。
#
# RUSTUP_INIT_SKIP_PATH_CHECK は、brew や apt で入れた rustc / cargo が PATH に
# あると rustup-init が確認を求めて止まるのを抑える。残っていることは最後に
# 知らせる。
#
# 導入後に実体を見にいくのを省いてはいけない。`curl ... | sh` の終了コードは
# sh のものであって curl のものではない。取得に失敗しても sh は空の入力を
# 読んで 0 を返す (run_after_60-install-ai-agents.sh.tmpl を参照)。
#
# 失敗しても中断しない。毎回走るスクリプトなので次の apply で再試行される。
# ---------------------------------------------------------------------------
if [ -x "$RUSTUP" ]; then
    # rustup はあるが既定のツールチェインが使えない (前回の途中で落ちた、
    # 手で消した)。既定が決まっていればその版を入れ直し、無ければ stable にする。
    toolchain="$(default_toolchain)"
    if [ -n "$toolchain" ]; then
        log "既定の Rust ツールチェイン ($toolchain) を入れ直します"
        "$RUSTUP" toolchain install "$toolchain" || true
    else
        log 'Rust の stable ツールチェインを導入します'
        "$RUSTUP" default stable || true
    fi
else
    log 'Rust (rustup) を導入します'
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | RUSTUP_INIT_SKIP_PATH_CHECK=yes sh -s -- \
            -y --no-modify-path --profile default --default-toolchain stable \
        || true
fi

toolchain=''
[ -x "$RUSTUP" ] && toolchain="$(default_toolchain)"
if ! toolchain_works "$toolchain"; then
    warn 'Rust の導入に失敗しました。次の chezmoi apply で再試行します。'
    exit 0
fi

log "導入した Rust: $("$RUSTUP" run "$toolchain" rustc --version)"

# ---------------------------------------------------------------------------
# リンカが無いことを知らせる
#
# rustc は自分ではリンクせず cc を呼ぶ。無いと cargo build が最後の段で
# "linker `cc` not found" で落ちる。パッケージ導入スクリプトが入れるはずだが、
# そこで失敗していると気づきにくいので確かめる。
{{- if eq .chezmoi.os "darwin" }}
#
# macOS では command -v cc で確かめてはいけない。/usr/bin/cc は Command Line
# Tools への中継で、CLT が無くても必ず存在する。CLT の有無は xcode-select -p
# で見る。Homebrew の導入で CLT は入るが、あとから消したマシンもありうる。
# ---------------------------------------------------------------------------
if ! xcode-select -p >/dev/null 2>&1; then
    warn 'Command Line Tools が見つかりません。cargo build はリンクの段で失敗します。'
    warn '  xcode-select --install で入れてください。'
fi
{{- else }}
# ---------------------------------------------------------------------------
if ! command -v cc >/dev/null 2>&1; then
    warn 'リンカ (cc) が見つかりません。cargo build はリンクの段で失敗します。'
    warn '  build-essential (Debian 系) か base-devel (Arch) を入れてください。'
fi
{{- end }}

# ---------------------------------------------------------------------------
# 他の経路で入れた cargo が残っていることを知らせる
#
# 消しはしない。判断は任せる。理由と、1 度だけ知らせる理由は
# run_after_50-install-node.sh.tmpl の node と同じである。
# ---------------------------------------------------------------------------
other_cargo="$(command -v cargo 2>/dev/null || true)"
case "$other_cargo" in
    ''|"$CARGO_HOME"/*) ;;
    *)
        log "rustup 以外の cargo も残っています: $other_cargo"
        case "$other_cargo" in
            "$HOME"/.local/bin/*)
                # ~/.local/bin は .zshenv の PATH で $CARGO_HOME/bin より前にある。
                log '  ここは PATH で rustup 版より前なので、そちらが使われます。'
                log "  rustup 版を使うなら $other_cargo を退けてください。"
                ;;
            *)
                log '  シェルの中では rustup 版が先に見つかるので、そのままでも困りません。'
                case "$other_cargo" in
                    /opt/homebrew/*) log '  整理するなら brew uninstall rust' ;;
                esac
                ;;
        esac
        ;;
esac

log 'Rust の導入が完了しました。新しいシェルを開いてから cargo を使ってください。'
{{ end -}}
