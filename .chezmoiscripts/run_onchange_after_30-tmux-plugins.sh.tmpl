#!/bin/sh
#
# TPM 管理下の tmux プラグインを非対話で導入する。
#
# run_onchange_ なので、下の 3 行のいずれかが変わったときだけ再実行される。
#
#   1. tmux.conf のハッシュ = プラグインリストが変わったとき
#   2. TPM の有無           = 前回 TPM が無くて何もできなかった環境に
#                             TPM が現れたとき
#   3. tmux の有無          = 前回 tmux が PATH に無くて何もできなかった環境で
#                             見えるようになったとき
#
# 2 と 3 を入れているのは、下でどちらも見つからないときに exit 0 するため。
# exit 0 は chezmoi にとって成功なので、そのハッシュは「実行済み」として
# 記録される。トリガが tmux.conf だけだと、一度スキップした環境では
# プラグインが二度と導入されず、tmux.conf を編集するまで静かに壊れたままになる。
#
# tmux.conf hash: {{ include "dot_config/tmux/tmux.conf" | sha256sum }}
# tpm: {{ if stat (joinPath .chezmoi.homeDir ".config/tmux/plugins/tpm/bin/install_plugins") }}present{{ else }}absent{{ end }}
# tmux: {{ if lookPath "tmux" }}present{{ else }}absent{{ end }}

set -eu

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew のパスを通す。
#
# chezmoi のスクリプトは起動元シェルの PATH をそのまま引き継ぐ。素の macOS の
# PATH に /opt/homebrew/bin は入っておらず、そこを通すのはこのリポジトリが
# 配置する .zshrc なので、初回セットアップの時点ではまだ効いていない。
# パッケージ導入スクリプト (run_once_before_10) は同じことを自前でやっているが、
# 別プロセスなのでこちらには引き継がれない。
#
# これが無いと、tmux を入れた直後にもかかわらず command -v tmux が失敗し、
# 「tmux が見つかりません」と言ってプラグインを入れずに終わる。
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

{{ end -}}

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }

TPM_BIN="$HOME/.config/tmux/plugins/tpm/bin/install_plugins"

# ここで失敗しても chezmoi apply 全体を道連れにしない。tpm の取得は
# ネットワーク次第で落ちるし、tmux を使わない環境もある。どちらも
# 「設定の配置」そのものが失敗したわけではない。
if [ ! -x "$TPM_BIN" ]; then
    warn "TPM が見つかりません: $TPM_BIN"
    warn 'chezmoi apply が externals を取得できているか確認してください:'
    warn '  chezmoi apply --refresh-externals'
    warn 'TPM が入れば、上の tpm: 行が変わるので次の apply で自動的に導入されます。'
    warn '手で走らせ直したい場合は:'
    warn '  chezmoi state delete-bucket --bucket=scriptState && chezmoi apply'
    exit 0
fi

if ! command -v tmux >/dev/null 2>&1; then
    warn 'tmux が見つかりません。プラグインの導入をスキップします。'
    warn 'tmux を入れれば、上の tmux: 行が変わるので次の apply で導入されます。'
    exit 0
fi

log 'tmux プラグインを導入します'
"$TPM_BIN"
